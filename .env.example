# MS4 — Orquestador de Señales
# Copia este archivo como .env y rellena los valores reales.

# URLs de los microservicios que consume
MS2_URL=http://localhost:5002
MS3_URL=http://localhost:5003

# FinBot (/api/chat) — prioridad: Groq si hay GROQ_API_KEY; si no, OpenRouter
GROQ_API_KEY=your_groq_api_key
# Modelo Groq (ver https://console.groq.com/docs/models )
GROQ_MODEL=your_groq_model # Recomendamos usar llama-3.1-8b-instant
# Señales IA (/api/senales) — OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key